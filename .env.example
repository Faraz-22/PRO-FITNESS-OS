# === Database ===
# Local connection string for Docker Compose setup
DATABASE_URL="postgresql://profitness_user:profitness_password@localhost:5432/profitness_db?schema=public"

# === Authentication (Auth.js) ===
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string-in-production"
# URL of the application
NEXTAUTH_URL="http://localhost:3000"

# === Application ===
# Public URL exposed to the client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# === Email (Resend) - Phase 1 ===
RESEND_API_KEY=""
EMAIL_FROM="ProFitness <noreply@profitness.in>"

# === Object Storage (S3/MinIO) - Phase 1 ===
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_PUBLIC_URL=""

# === Redis (BullMQ/Caching) - Phase 1 ===
# Local connection string for Docker Compose setup
REDIS_URL="redis://localhost:6379"

# === Payments (Razorpay) - Phase 4 ===
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
